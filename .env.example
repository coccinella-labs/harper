# Harper environment template
#
# Copy to `.env` and fill in only the provider you plan to use.

# OpenAI
# OPENAI_API_KEY=sk-your-openai-key

# Sambanova
# SAMBASTUDIO_API_KEY=your-sambanova-key

# Google Gemini
# GEMINI_API_KEY=your-gemini-key

# Cerebras
# CEREBRAS_API_KEY=your-cerebras-key

# Ollama (local/offline)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# OpenRouter (https://openrouter.ai)
# OPENROUTER_API_KEY=sk-or-v1-your-key

# OpenCode Zen (https://opencode.ai/zen)
# OPENCODE_API_KEY=sk-your-zen-key

# Optional overrides
# DATABASE_PATH=./harper.db

# Or copy config/local.toml to config.toml and adjust settings
